# ─── DEVELOPMENT settings ────────────────────────────────────────────
# Copy to server/.env for local work. server/.env is git-ignored; never
# commit it. Production settings are listed in .env.production.example and
# are entered in the hosting provider's dashboard, not in a file.
NODE_ENV=development
PORT=4000

# Required. Use a DEVELOPMENT database here, never the production one.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/careercore_dev?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

ML_SERVICE_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# Optional: email copies of notifications. Leave empty for in-app only.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional: inbox that receives a copy of each contact-form message (needs the
# SMTP settings above). Messages are always stored and shown to administrators.
CONTACT_INBOX=

# Demo data: `npm run seed`, `npm run seed:cohort` and `npm run db:clean`
# only write to the database named here, as "<hosts>/<database name>", and
# never when NODE_ENV=production. Leave empty until you have a development
# database; a refused run prints the exact value for the database it reached.
# Never set this on a production host (the API refuses to start if it is).
DEMO_SEED_DATABASE=

# Optional: set to true to turn off scheduled jobs (reminders, auto-closing
# registration at the deadline).
DISABLE_CRON=false

# ─── Scaling & deployment ────────────────────────────────────────────
# Worker processes per instance: a number, or "auto" for one per CPU core.
# Leave unset (or 1) for a single process.
WEB_CONCURRENCY=
# MongoDB connections per process. Total ≈ pool × workers × instances; keep
# it under your cluster's connection limit.
MONGO_POOL_SIZE=20
# Proxy hops to trust for the client IP (rate limiting). Defaults to 1 in
# production; set to 0 if the API is exposed directly.
TRUST_PROXY=
# Shared directory for uploaded files when running several instances.
UPLOAD_DIR=
# CLIENT_URL above may hold several origins, comma-separated.
