# ─── PRODUCTION settings for the website (reference only) ───────────
# Enter these in Vercel: Project -> Settings -> Environment Variables, for
# the Production environment. Do not commit a filled-in copy. They are read
# at build time, so redeploy after changing one.
#
# These values are public: they end up in the JavaScript and HTML that
# browsers download. Never put a credential here; the build stops if a
# VITE_ variable looks like one.

# The API's address including /api, for example the Render service URL
# followed by /api. Required on Vercel, which does not run the API.
VITE_API_URL=

# The site's final public https address, no trailing slash. Leave EMPTY until
# the custom domain is decided: while empty, no canonical links, og:url,
# og:image, structured data or sitemap.xml are produced.
VITE_SITE_URL=

# "true" keeps every page out of search results (noindex) and skips
# sitemap.xml. Useful while the site runs on a temporary address. Remove it
# once the final domain is set.
VITE_SITE_NOINDEX=
