# ─── DEVELOPMENT settings ────────────────────────────────────────────
# Copy to server/.env for local work. server/.env is git-ignored; never
# commit it. Production settings are listed in .env.production.example and
# are entered in the hosting provider's dashboard, not in a file.
NODE_ENV=development
PORT=4000

# Required. Use a DEVELOPMENT database here, never the production one.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/careercore_dev?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

ML_SERVICE_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# Optional: email copies of notifications. Leave empty for in-app only.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# true for implicit TLS (port 465); leave empty to decide from the port.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# ─── Placement drive notifications (email + WhatsApp) ────────────────
# sandbox (default outside production): messages are rendered and recorded
#   as "simulated"; nothing is sent to anyone. Use this for development.
# live (default in production): really send. off: in-app notifications only.
NOTIFICATION_DELIVERY_MODE=sandbox
# The website's public address, used in every registration link. Falls back
# to the first CLIENT_URL entry.
PUBLIC_APP_URL=
APP_TIMEZONE=Asia/Kolkata
# Country code assumed for numbers typed without one.
DEFAULT_PHONE_COUNTRY_CODE=91

NOTIFY_EMAIL_ENABLED=true
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=CareerCore Placement Cell
EMAIL_REPLY_TO=

# WhatsApp Business Platform (Meta Cloud API). Stays off until an approved
# template exists; see DEPLOYMENT.md, "Placement drive notifications".
NOTIFY_WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_NAME=placement_drive_alert
WHATSAPP_TEMPLATE_LANGUAGE=en
# true when the approved template has a URL button ending in {{1}}.
WHATSAPP_TEMPLATE_URL_BUTTON=true
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Background delivery worker. off disables it (rows stay queued).
DELIVERY_WORKER=on
DELIVERY_POLL_INTERVAL_MS=30000
# Parallel sends per channel, per process (each channel has its own pool).
DELIVERY_CONCURRENCY=4
DELIVERY_EMAIL_CONCURRENCY=
DELIVERY_WHATSAPP_CONCURRENCY=
# Reused SMTP connections, and an optional per-second cap for providers
# with a sending limit (e.g. 14 for a new Amazon SES account).
SMTP_MAX_CONNECTIONS=5
SMTP_RATE_LIMIT_PER_SECOND=
DELIVERY_MAX_ATTEMPTS=5
DELIVERY_BACKOFF_BASE_MS=60000
DELIVERY_BACKOFF_MAX_MS=3600000
# Optional: inbox that receives a copy of each contact-form message (needs the
# SMTP settings above). Messages are always stored and shown to administrators.
CONTACT_INBOX=

# Demo data: `npm run seed`, `npm run seed:cohort` and `npm run db:clean`
# only write to the database named here, as "<hosts>/<database name>", and
# never when NODE_ENV=production. Leave empty until you have a development
# database; a refused run prints the exact value for the database it reached.
# Never set this on a production host (the API refuses to start if it is).
DEMO_SEED_DATABASE=

# Optional: set to true to turn off scheduled jobs (reminders, auto-closing
# registration at the deadline).
DISABLE_CRON=false

# ─── Scaling & deployment ────────────────────────────────────────────
# Worker processes per instance: a number, or "auto" for one per CPU core.
# Leave unset (or 1) for a single process.
WEB_CONCURRENCY=
# MongoDB connections per process. Total ≈ pool × workers × instances; keep
# it under your cluster's connection limit.
MONGO_POOL_SIZE=20
# Proxy hops to trust for the client IP (rate limiting). Defaults to 1 in
# production; set to 0 if the API is exposed directly.
TRUST_PROXY=
# Shared directory for uploaded files when running several instances.
UPLOAD_DIR=
# CLIENT_URL above may hold several origins, comma-separated.
