NODE_ENV=development
PORT=4000

# Required
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/careercore?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

ML_SERVICE_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# Optional: email copies of notifications. Leave empty for in-app only.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional: set to true to turn off scheduled jobs (reminders, auto-closing
# registration at the deadline).
DISABLE_CRON=false
