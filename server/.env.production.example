# ─── PRODUCTION settings for the API (reference only) ───────────────
# Enter these in your API host's dashboard (for example Render: Service ->
# Environment). Do not create a server/.env.production file with real
# values, and never commit one: every .env file except the *.example
# templates is git-ignored. Everything here is blank on purpose.
#
# In production the API refuses to start when JWT_SECRET, MONGO_URI or
# CLIENT_URL is missing or unsafe, or when DEMO_SEED_DATABASE is set
# (see server/config/env.js).

NODE_ENV=production

# Required. The PRODUCTION database connection string.
MONGO_URI=

# Required. A long random value (at least 32 characters) used only in
# production. Render can generate one (see render.yaml).
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Required. The website's https address(es), comma-separated, with no
# trailing slash: the Vercel production address, and later your custom
# domain. Used for CORS and for links in notification emails.
CLIENT_URL=

# The ML service's address, e.g. its Render URL. If unreachable, the API
# keeps working and reports ML features as unavailable.
ML_SERVICE_URL=

# Proxy hops in front of the API, for the client IP used by rate limiting.
# Defaults to 1 in production. Confirm it on your host (see DEPLOYMENT.md).
TRUST_PROXY=

# Where uploaded resume photos are stored. On Render this must be on a
# persistent disk (paid plans), or uploads are lost on every restart.
UPLOAD_DIR=

# Worker processes: 1 for small instances, a number, or "auto".
WEB_CONCURRENCY=1
MONGO_POOL_SIZE=20

# Optional email (leave empty for in-app notifications only).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
CONTACT_INBOX=

# Placement drive notifications. Production defaults to live delivery; set
# NOTIFICATION_DELIVERY_MODE=sandbox on a staging copy of the API.
NOTIFICATION_DELIVERY_MODE=live
# The website's https address used in registration links (defaults to the
# first CLIENT_URL entry).
PUBLIC_APP_URL=
APP_TIMEZONE=Asia/Kolkata
DEFAULT_PHONE_COUNTRY_CODE=91
NOTIFY_EMAIL_ENABLED=true
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=CareerCore Placement Cell
EMAIL_REPLY_TO=

# WhatsApp (Meta Cloud API). With NOTIFY_WHATSAPP_ENABLED=true the API
# refuses to start unless the five WHATSAPP_* secrets below are set.
NOTIFY_WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_NAME=placement_drive_alert
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_URL_BUTTON=true
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

DELIVERY_WORKER=on

# Optional: true turns off scheduled jobs (reminders, closing registration
# at the deadline).
DISABLE_CRON=

# Must stay empty in production.
DEMO_SEED_DATABASE=
