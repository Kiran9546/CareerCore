# ─── DEVELOPMENT settings for the website ───────────────────────────
# Optional. Copy to client/.env.local for local work (git-ignored).
#
# Everything named VITE_* is compiled into the JavaScript that browsers
# download, so it is public. Never put a password, token, secret or database
# address here: the build refuses variables that look like credentials.

# Leave empty in development: `npm run dev` proxies /api and /uploads to the
# API on http://localhost:4000.
VITE_API_URL=

# Leave empty in development. Canonical links, sitemap.xml and structured
# data are only produced when this is set (see .env.production.example).
VITE_SITE_URL=

# Leave empty in development.
VITE_SITE_NOINDEX=
